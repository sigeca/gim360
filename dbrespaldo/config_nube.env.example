# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE CONEXIÓN A LA BASE DE DATOS EN LA NUBE
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo como 'config_nube.env' en este mismo directorio:
#      cp config_nube.env.example config_nube.env
# 2. Edita 'config_nube.env' y coloca las credenciales de tu base de datos en la nube.
# 3. 'config_nube.env' está protegido en .gitignore y NUNCA se subirá a GitHub.
# ==============================================================================

# Servidor remoto / Nube (IP, dominio o endpoint del proveedor: cPanel, AWS, Railway, etc.)
CLOUD_DB_HOST="tu_host_en_la_nube"

# Puerto MySQL en la nube (por defecto 3306)
CLOUD_DB_PORT="3306"

# Nombre de la base de datos en la nube
CLOUD_DB_NAME="gim360"

# Usuario de MySQL en la nube
CLOUD_DB_USER="tu_usuario_remoto"

# Contraseña del usuario MySQL en la nube
CLOUD_DB_PASS="tu_password_remoto"

# Habilitar SSL si el proveedor en la nube lo requiere (true o false)
CLOUD_DB_SSL="false"

# ------------------------------------------------------------------------------
# Configuración Local (Opcional: toma automáticamente los valores de .env o los siguientes)
# ------------------------------------------------------------------------------
LOCAL_DB_HOST="localhost"
LOCAL_DB_PORT="3306"
LOCAL_DB_NAME="gim360"
LOCAL_DB_USER="root"
LOCAL_DB_PASS="PIWIIB1234"
